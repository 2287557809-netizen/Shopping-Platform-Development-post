{
  "info": {
    "name": "ShopStream - Gateway API",
    "description": "Demo collection for the ShopStream distributed e-commerce backend.\n\nEvery request goes through the API gateway on http://localhost:8080. No business service port is used.\n\nRun the folders in order:\n0 Smoke -> 1 Products -> 2 Search -> 3 Cart -> 4 Orders -> 5 Notifications\n\nVariables are captured automatically (productId, productId2, orderId, orderId2).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "demo-user" },
    { "key": "productId", "value": "1" },
    { "key": "productId2", "value": "2" },
    { "key": "tempProductId", "value": "3" },
    { "key": "orderId", "value": "1" },
    { "key": "orderId2", "value": "2" }
  ],
  "item": [
    {
      "name": "0 - Smoke tests",
      "item": [
        {
          "name": "Gateway is up (list products)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Proves that the only published endpoint, the gateway on 8080, can reach product-service through Eureka."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Gateway answers with 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Gateway adds X-Request-Id', function () {",
                  "  pm.expect(pm.response.headers.has('X-Request-Id')).to.be.true;",
                  "});",
                  "",
                  "pm.test('Response body is a JSON array', function () {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown product returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "999999"]
            },
            "description": "Explicit cache-aside never stores a missing product, so this always hits the database and returns 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing product is 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('404 response has no cached marker header', function () {",
                  "  pm.expect(pm.response.headers.has('X-Cache')).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 - Products",
      "item": [
        {
          "name": "Create product A (Laptop)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Pro 14\",\n  \"description\": \"14 inch developer laptop with 32 GB RAM\",\n  \"category\": \"electronics\",\n  \"price\": 1299.00,\n  \"stock\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Creates a product; the id is stored in {{productId}} and reused by the cart and order folders."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const product = pm.response.json();",
                  "pm.collectionVariables.set('productId', String(product.id));",
                  "pm.test('Response has a generated id', function () {",
                  "  pm.expect(product.id).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create product B (Keyboard)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"description\": \"Hot-swappable mechanical keyboard\",\n  \"category\": \"accessories\",\n  \"price\": 89.00,\n  \"stock\": 10\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.collectionVariables.set('productId2', String(pm.response.json().id));"
                ]
              }
            }
          ]
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List contains at least two products', function () {",
                  "  pm.expect(pm.response.json().length).to.be.at.least(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product (cache MISS expected)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            },
            "description": "First read after a write: the Redis key was evicted or never created, so the service reads PostgreSQL and repopulates the cache."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('X-Cache header is exposed', function () {",
                  "  pm.expect(pm.response.headers.get('X-Cache')).to.be.oneOf(['MISS', 'HIT']);",
                  "});",
