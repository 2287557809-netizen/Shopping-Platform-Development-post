          ]
        },
        {
          "name": "Get product again (cache HIT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            },
            "description": "Second read is served from Redis without touching PostgreSQL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Second read is a cache hit', function () {",
                  "  pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update product (evicts cache)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
