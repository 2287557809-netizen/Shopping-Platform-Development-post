    {
      "name": "4 - Orders and inventory Saga",
      "item": [
        {
          "name": "Create order with too much stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 999 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Order-service prices the order through Feign and publishes OrderCreated; product-service rejects it because stock is insufficient."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order accepted for processing', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('orderId2', String(pm.response.json().id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read first order (poll until confirmed)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}"]
            },
            "description": "Polls the order endpoint until the inventory Saga leaves PENDING. Product rows are locked with SELECT ... FOR UPDATE and stock is decremented in one transaction."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "const orderId = pm.collectionVariables.get('orderId');",
                  "let attempts = 0;",
                  "",
                  "function poll() {",
                  "  pm.sendRequest(baseUrl + '/api/orders/' + orderId, function (err, res) {",
                  "    if (err) { console.error(err); return; }",
                  "    const order = res.json();",
                  "    if (order.status === 'PENDING' && attempts < 10) {",
                  "      attempts += 1;",
                  "      setTimeout(poll, 500);",
                  "      return;",
                  "    }",
                  "    pm.test('Order is CONFIRMED by the inventory Saga', function () {",
                  "      pm.expect(order.status).to.eql('CONFIRMED');",
                  "    });",
                  "    pm.test('Stock was reserved exactly once', function () {",
                  "      pm.expect(order.items.length).to.be.at.least(1);",
                  "    });",
                  "    pm.collectionVariables.set('orderStatus', order.status);",
                  "  });",
                  "}",
                  "",
                  "poll();"
                ]
              }
            }
          ]
        },
        {
          "name": "Read rejected order (poll until rejected)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId2}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId2}}"]
            },
            "description": "The whole reservation is rolled back when one item is short, so no partial stock deduction can happen."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "const orderId = pm.collectionVariables.get('orderId2');",
                  "let attempts = 0;",
                  "",
                  "function poll() {",
                  "  pm.sendRequest(baseUrl + '/api/orders/' + orderId, function (err, res) {",
                  "    if (err) { console.error(err); return; }",
                  "    const order = res.json();",
                  "    if (order.status === 'PENDING' && attempts < 10) {",
                  "      attempts += 1;",
                  "      setTimeout(poll, 500);",
                  "      return;",
                  "    }",
                  "    pm.test('Order is REJECTED', function () {",
                  "      pm.expect(order.status).to.eql('REJECTED');",
                  "    });",
                  "    pm.test('Rejection carries a reason', function () {",
                  "      pm.expect(order.failureReason).to.be.a('string').and.not.empty;",
                  "    });",
                  "  });",
                  "}",
                  "",
                  "poll();"
                ]
              }
            }
          ]
        },
        {
          "name": "List confirmed orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders?status=CONFIRMED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [{ "key": "status", "value": "CONFIRMED" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Only confirmed orders are returned', function () {",
                  "  pm.response.json().forEach(function (order) {",
                  "    pm.expect(order.status).to.eql('CONFIRMED');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
